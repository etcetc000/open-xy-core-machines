<g id="ensemble_panel">
<!-- SDK effect page (opxy/effect_page.hpp), after stock's FX page: keep this block first.
     As in stock's artwork, every shape is a plain fill on whole pixels, with no stroke.
     The badge, "FX" and the name are stock's size and place; the badge's corners are
     notched a pixel rather than curved. Bright and dim boxes and bars trade rows; the
     meters are 1 px lines on the band. -->
<path d="M0,0 L480,0 L480,220 L0,220 Z" fill="#000000"/>
<path d="M181,25 L234,25 L234,26 L235,26 L235,54 L234,54 L234,55 L181,55 L181,54 L180,54 L180,26 L181,26 Z M181,26 L181,54 L234,54 L234,26 Z" fill="#CDCDCD"/>
<text transform="matrix(1 0 0 1 188.45 47.5)" fill="#CDCDCD" font-family="UniversNextPro-Light" font-size="20px">FX</text>
<text transform="matrix(1 0 0 1 250 46)" fill="#CDCDCD" font-family="UniversNextPro-Light" font-size="20px">ensemble</text>
