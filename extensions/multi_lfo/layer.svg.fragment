  <text id="multi_lfo_value1" transform="matrix(1 0 0 1 140 150)" fill="#F2F2F2" font-family="UniversNextPro-Light" font-size="24">100%......</text>
  <text id="multi_lfo_value2" transform="matrix(1 0 0 1 256 150)" fill="#F2F2F2" font-family="UniversNextPro-Light" font-size="24">100%......</text>
  <text id="multi_lfo_value3" transform="matrix(1 0 0 1 372 150)" fill="#F2F2F2" font-family="UniversNextPro-Light" font-size="24">100%......</text>
  <text id="multi_lfo_hint" transform="matrix(1 0 0 1 24 200)" fill="#8C8C8C" font-family="UniversNextPro-Light" font-size="18">M4 on/off, Shift+M4 type.......</text>
</g>
